{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Set any cape by URL - visible to all EasyCapes players, instant updates",
  "authors": [
    "qoofix"
  ],
  "license": "MIT",
  "icon": "assets/easycapes/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.qoofix.easycapes.platform.fabric.FabricEasyCapes"
    ]
  },
  "mixins": [
    "easycapes.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "${minecraft}",
    "fabric-command-api-v2": "*",
    "fabric-lifecycle-events-v1": "*",
    "fabric-networking-api-v1": "*"
  }
}