{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Set any cape by URL - visible to all EasyCapes players, instant updates",
  "authors": [
    "qoofix"
  ],
  "license": "MIT",
  "icon": "assets/easycapes/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "me.qoofix.easycapes.EasyCapesMod"
    ],
    "client": [
      "me.qoofix.easycapes.client.EasyCapesClient"
    ]
  },
  "mixins": [
    "easycapes.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "${minecraft}",
    "fabric-api": "*"
  }
}